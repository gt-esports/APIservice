GAMEFEST_SUPABASE_URL=https://your-project.supabase.co
GAMEFEST_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Main-site identity and private contacts use a separate Supabase project.
# Use the same public credentials as the main site, never a service-role key.
MAIN_SITE_SUPABASE_URL=https://your-main-site-project.supabase.co
MAIN_SITE_SUPABASE_PUBLISHABLE_KEY=your-public-anon-or-publishable-key
# Add the exact main-site origin (local Vite default: http://localhost:5173)
# to CORS_ALLOWED_ORIGINS above. Do not use a wildcard.

# The optional local auth demo runs separately on port 8001.
# Never enable it or reuse a development key in production.
ENABLE_DEV_AUTH=false
JWT_SECRET=
JWT_ISSUER=gt-esports-dev
JWT_AUDIENCE=gt-esports-api
